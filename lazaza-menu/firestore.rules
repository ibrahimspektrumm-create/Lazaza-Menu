rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read the menu (customers). Only the logged-in admin can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Recovery-code hash for changing the admin password.
    // Never publicly readable - only the authenticated admin session can read/write it.
    match /adminSecurity/{docId} {
      allow read, write: if request.auth != null;
    }

    // Single-active-session lock. The admin panel reads this continuously
    // (even mid-session) to detect a login from another device and self-logout.
    match /adminSession/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
